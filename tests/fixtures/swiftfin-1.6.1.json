      "Format": "subrip",
      "Method": "Embed"
    },
    {
      "Format": "subrip",
      "Method": "External"
    },
    {
      "Format": "vtt",
      "Method": "Encode"
    },
    {
      "Format": "pgssub",
      "Method": "Encode"
    }
  ]
